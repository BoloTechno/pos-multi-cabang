# Copy to .env for Docker Compose; Django itself reads exported environment variables.
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
CURRENCY=IDR
# Production only:
# DATABASE_URL=postgresql://user:password@host:5432/pos?sslmode=require
# CSRF_TRUSTED_ORIGINS=https://pos.example.com
# TRUST_PROXY=true
